{
  "name": "@jzohdi/react-draw",
  "version": "0.9.33",
  "description": "A plugin architecture react library for adding drawing ability in the browser.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jzohdi/reactdraw.git"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "env TS_NODE_COMPILER_OPTIONS='{\"module\": \"commonjs\", \"moduleResolution\": \"node10\" }' mocha --timeout 60000 --exit",
    "build": "rm -rf ./dist && rollup -c",
    "add": "npm run build && npm run build-storybook && git add -A",
    "push": "npm version patch && git push --follow-tags",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "react",
    "typescript",
    "small",
    "bundle",
    "drawing",
    "paint",
    "color",
    "plugin"
  ],
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "react": ">= 16.8.0",
    "react-dom": ">= 16.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@jzohdi/jsx-icons": "^0.0.25",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-onboarding": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.3.0",
    "babel-loader": "^8.4.1",
    "mocha": "^12.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.67.4",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-ts": "^3.4.5",
    "storybook": "^10.6.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.4.5",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
